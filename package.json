{
  "name": "tiny-pending-item",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "轻量级个人待办任务列表：注册登录 + 账号数据隔离",
  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env JWT_SECRET=dev-secret-tiny-pending-item tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.10"
  }
}
